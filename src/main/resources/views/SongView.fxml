<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="480.0" prefWidth="640.0" spacing="10.0" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.easv.mytunes.GUI.Controller.SongViewController">
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
   <children>
      <HBox spacing="10.0">
         <children>
            <TextField fx:id="txtTitle" promptText="Title" HBox.hgrow="ALWAYS" />
            <TextField fx:id="txtArtist" promptText="Artist" HBox.hgrow="ALWAYS" />
            <TextField fx:id="txtGenre" promptText="Genre" HBox.hgrow="ALWAYS" />
            <TextField fx:id="txtTime" prefWidth="90.0" promptText="Time (m:ss)" />
         </children>
      </HBox>
      <HBox spacing="10.0">
         <children>
            <Button fx:id="btnCreate" mnemonicParsing="false" onAction="#onCreate" prefWidth="90.0" text="Create" />
            <Button fx:id="btnUpdate" mnemonicParsing="false" onAction="#onUpdate" prefWidth="90.0" text="Update" />
            <Button fx:id="btnDelete" mnemonicParsing="false" onAction="#onDelete" prefWidth="90.0" text="Delete" />
         </children>
      </HBox>
      <HBox spacing="10.0">
         <children>
            <TextField fx:id="txtFilter" onAction="#onFilter" promptText="Filter by title or artist" HBox.hgrow="ALWAYS" />
            <Button fx:id="btnFilter" mnemonicParsing="false" onAction="#onFilter" prefWidth="70.0" text="Filter" />
         </children>
      </HBox>
      <TableView fx:id="tblSongs" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="colTitle" prefWidth="200.0" text="Title" />
            <TableColumn fx:id="colArtist" prefWidth="170.0" text="Artist" />
            <TableColumn fx:id="colGenre" prefWidth="130.0" text="Genre" />
            <TableColumn fx:id="colTime" prefWidth="80.0" text="Time" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
</VBox>
