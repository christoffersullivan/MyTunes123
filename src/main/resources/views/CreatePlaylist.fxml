<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="246.0" prefWidth="600.0" style="-fx-background-color: #3A3A3A;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.easv.mytunes.GUI.Controller.CreatePlaylistController">
   <children>
      <Label layoutX="231.0" layoutY="33.0" prefHeight="32.0" prefWidth="138.0" style="-fx-background-color: #DC143C;" text=" Create a playlist" textAlignment="JUSTIFY">
         <opaqueInsets>
            <Insets />
         </opaqueInsets>
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Label layoutX="14.0" layoutY="110.0" prefHeight="27.0" prefWidth="116.0" style="-fx-background-color: #DC143C;" text=" Playlist name">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <TextField fx:id="txtPlaylistName" layoutX="140.0" layoutY="110.0" prefHeight="26.0" prefWidth="370.0" promptText="give the playlist a name" />
      <Button fx:id="btnCreate" onAction="#handleCreate" layoutX="189.0" layoutY="171.0" mnemonicParsing="false" prefHeight="26.0" prefWidth="82.0" style="-fx-background-color: #DC143C;" text="Create" />
      <Button fx:id="btnCancel" onAction="#handleCancel" layoutX="328.0" layoutY="171.0" mnemonicParsing="false" prefHeight="26.0" prefWidth="81.0" text="Cancel" />
   </children>
</AnchorPane>
